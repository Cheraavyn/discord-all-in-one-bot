# Wajib
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Opsional
DISCORD_GUILD_ID=
OWNER_IDS=
MUSIC_VOLUME=80
MUSIC_MAX_QUEUE=200 # 0 = tanpa batas; 200 disarankan agar playlist bermasalah tidak membanjiri antrean
EMBED_COLOR=5865f2

# Opsional: Spotify (isi keduanya atau kosongkan keduanya)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opsional: hanya isi true jika Message Content Intent sudah diaktifkan di Developer Portal
MESSAGE_CONTENT_INTENT=false

# Opsional: atasi error YouTube "Sign in to confirm you're not a bot".
# Export cookies.txt (format Netscape) dari browser yang sudah login YouTube,
# upload ke hosting, lalu isi path absolut yang BENAR-BENAR ada di mesin bot.
# Jangan isi path container kalau bot dijalankan di mesin lain. Jangan bagikan file ini.
YT_COOKIES_FILE=

# Opsional: argumen tambahan yt-dlp, misalnya youtube:player_client=web_safari
YT_EXTRACTOR_ARGS=

# Opsional: player client YouTube yang dicoba berurutan bila client utama ditolak.
# Kosongkan untuk memakai default: web_embedded,web_safari,mweb,android_vr,ios,tv_downgraded
YT_PLAYER_CLIENTS=

# Opsional: proxy untuk yt-dlp bila IP hosting diblokir YouTube.
# Contoh: http://user:pass@host:port atau socks5://host:port
YTDLP_PROXY=
